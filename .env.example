# HookScope binds only to loopback by default.
HOOKSCOPE_HOST=127.0.0.1
HOOKSCOPE_PORT=4173
HOOKSCOPE_DATA_DIR=./data
HOOKSCOPE_MAX_BODY_BYTES=262144
HOOKSCOPE_MAX_CAPTURES=500
HOOKSCOPE_MAX_DB_BYTES=268435456

# Replay is disabled when this is empty. Every URL must use a literal loopback
# address (127.0.0.1 or ::1), with no credentials, query, or fragment.
HOOKSCOPE_REPLAY_TARGETS=[]

# Additional exact header names to redact; built-in sensitive names stay redacted.
HOOKSCOPE_REDACT_HEADERS=
